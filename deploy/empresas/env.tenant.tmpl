# .env de la empresa __SLUG__ — generado por scripts/nueva_empresa.sh el __FECHA__
# NO compartir con otras empresas: llaves y contraseñas son propias de esta instancia.

# ── Variables que usa docker compose (plantilla docker-compose.tenant.yml) ──
SLUG=__SLUG__
PUERTO=__PUERTO__
IMAGEN=__IMAGEN__
ENV_FILE=__ENV_FILE__
BIND=127.0.0.1   # solo nginx del host llega al puerto; cambia a 0.0.0.0 si quieres exponerlo directo

# ── Django ──
DJANGO_SECRET_KEY=__SECRET_KEY__
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=__ALLOWED_HOSTS__
CSRF_TRUSTED_ORIGINS=__CSRF_ORIGINS__

# ── Base de datos (MySQL compartido crm-mysql, base y usuario propios) ──
DB_NAME=crm___SLUG__
DB_USER=u___SLUG__
DB_PASSWORD=__DB_PASSWORD__
DB_HOST=crm-mysql
DB_PORT=3306

# ── Correo (cifrado de contraseñas de buzones; llave Fernet propia) ──
MAIL_ENCRYPTION_KEY=__MAIL_KEY__

# ── Asistente con IA ──
OPENROUTER_API_KEY=__OPENROUTER_KEY__
LITELLM_MODEL=openrouter/openai/gpt-4o-mini
RESUMEN_HABILITADO=1

# ── Superusuario inicial (lo crea docker-entrypoint.sh al arrancar si no existe) ──
DJANGO_SUPERUSER_EMAIL=__ADMIN_EMAIL__
DJANGO_SUPERUSER_PASSWORD=__ADMIN_PASSWORD__

# ── Integraciones del sitio de IAMET: vacías (módulos apagados en esta empresa) ──
SITIO_WEB_URL=

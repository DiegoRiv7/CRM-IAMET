# .env del CRM COMPARTIDO (multitenant bridge) — generado por scripts/instalar_bridge.sh el __FECHA__
# Una sola app atiende a TODAS las empresas; cada una vive en su base crm_<slug>.
# NO poner aquí DJANGO_SUPERUSER_*: en modo tenant el entrypoint no debe crear usuarios.

# ── docker compose (plantilla docker-compose.bridge.yml) ──
IMAGEN=__IMAGEN__
PUERTO=__PUERTO__
BIND=127.0.0.1

# ── Django ──
TENANT_MODE=1
DJANGO_SECRET_KEY=__SECRET_KEY__
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost
# Sufijos de host de las empresas (comodín). El registro de control es el gate real.
TENANT_HOST_SUFFIXES=.__IP_GUIONES__.nip.io,.crm.iamet.mx

# ── Base de datos de CONTROL (solo el registro de empresas) ──
CONTROL_DB_NAME=crm_control
CONTROL_DB_USER=u_control
CONTROL_DB_PASSWORD=__CONTROL_PASSWORD__
CONTROL_DB_HOST=crm-mysql
CONTROL_DB_PORT=3306

# ── Asistente con IA (compartido entre empresas; ver OPENROUTER_API_KEY_COMPARTIDA en .env.core) ──
OPENROUTER_API_KEY=__OPENROUTER_KEY__
LITELLM_MODEL=openrouter/openai/gpt-4o-mini
RESUMEN_HABILITADO=1

# ── Login único: si se define, /app/login/ de TODAS las empresas redirige al portal ──
PORTAL_URL=__PORTAL_URL__
